{
  "name": "ugc-lens",
  "version": "0.0.11",
  "description": "面向文本记录、评论、弹幕等内容的轻量分析 Agent",
  "keywords": [
    "ugc",
    "comments",
    "danmaku",
    "bilibili",
    "llm",
    "agent",
    "analysis",
    "评论分析",
    "弹幕"
  ],
  "homepage": "https://github.com/sansan-mei/ugc-lens#readme",
  "bugs": {
    "url": "https://github.com/sansan-mei/ugc-lens/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sansan-mei/ugc-lens.git"
  },
  "license": "MIT",
  "author": "MEI",
  "type": "module",
  "bin": {
    "ugc-lens": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "default": "./dist/mcp/server.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "playbook"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "build": "node scripts/build.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "chat": "node examples/01_chat.ts",
    "models": "node examples/01_list_models.ts",
    "multi": "node examples/02_multi_turn.ts",
    "loop": "node examples/03_agent_loop.ts",
    "tools": "node examples/04_tools.ts",
    "params": "node examples/05_param_errors.ts",
    "retry": "node examples/06_retry_budget.ts",
    "stats": "node examples/07_dataset_stats.ts",
    "ask": "node examples/08_ask.ts",
    "chunks": "node examples/09_chunks.ts",
    "summarize": "node examples/09_summarize.ts",
    "analyze": "node examples/09_analyze.ts",
    "watch": "node src/cli/index.ts watch",
    "smoke": "node examples/00_hello.ts && node examples/01_list_models.ts && node examples/03_agent_loop.ts 1 && node examples/04_tools.ts < /dev/null && node examples/06_retry_budget.ts retry && node examples/07_dataset_stats.ts --fresh && node examples/08_ask.ts \"评论里有人提到价格吗？\" && node examples/09_chunks.ts && node examples/09_summarize.ts && node examples/09_analyze.ts > /dev/null"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@mozilla/readability": "0.6.0",
    "linkedom": "0.18.15",
    "zod": "4.6.7"
  }
}
