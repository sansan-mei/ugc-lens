{
  "name": "ugc-lens",
  "version": "0.0.19",
  "description": "面向文本记录、评论、弹幕等内容的轻量分析 Agent",
  "keywords": [
    "ugc",
    "comments",
    "danmaku",
    "bilibili",
    "llm",
    "agent",
    "analysis",
    "评论分析",
    "弹幕"
  ],
  "homepage": "https://github.com/sansan-mei/ugc-lens#readme",
  "bugs": {
    "url": "https://github.com/sansan-mei/ugc-lens/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sansan-mei/ugc-lens.git"
  },
  "license": "MIT",
  "author": "MEI",
  "type": "module",
  "bin": {
    "ugc-lens": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "default": "./dist/mcp/server.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "playbook",
    "ui"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "build": "node scripts/build.ts && npm run build:ui",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "chat": "node --env-file-if-exists=.env examples/01_chat.ts",
    "models": "node --env-file-if-exists=.env examples/01_list_models.ts",
    "multi": "node --env-file-if-exists=.env examples/02_multi_turn.ts",
    "loop": "node --env-file-if-exists=.env examples/03_agent_loop.ts",
    "tools": "node --env-file-if-exists=.env examples/04_tools.ts",
    "params": "node --env-file-if-exists=.env examples/05_param_errors.ts",
    "retry": "node --env-file-if-exists=.env examples/06_retry_budget.ts",
    "stats": "node --env-file-if-exists=.env examples/07_dataset_stats.ts",
    "ask": "node --env-file-if-exists=.env examples/08_ask.ts",
    "chunks": "node --env-file-if-exists=.env examples/09_chunks.ts",
    "summarize": "node --env-file-if-exists=.env examples/09_summarize.ts",
    "analyze": "node --env-file-if-exists=.env examples/09_analyze.ts",
    "watch": "node src/cli/index.ts watch",
    "smoke": "node --env-file-if-exists=.env examples/00_hello.ts && node --env-file-if-exists=.env examples/01_list_models.ts && node --env-file-if-exists=.env examples/03_agent_loop.ts 1 && node --env-file-if-exists=.env examples/04_tools.ts < /dev/null && node --env-file-if-exists=.env examples/06_retry_budget.ts retry && node --env-file-if-exists=.env examples/07_dataset_stats.ts --fresh && node --env-file-if-exists=.env examples/08_ask.ts \"评论里有人提到价格吗？\" && node --env-file-if-exists=.env examples/09_chunks.ts && node --env-file-if-exists=.env examples/09_summarize.ts && node --env-file-if-exists=.env examples/09_analyze.ts > /dev/null",
    "build:ui": "vite build --config web/vite.config.ts"
  },
  "devDependencies": {
    "@animate-ui/react": "2.4.3",
    "@fontsource-variable/outfit": "5.3.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "motion": "14.11.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@mozilla/readability": "0.6.0",
    "linkedom": "0.18.15",
    "zod": "4.6.7"
  }
}
